{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "types": ["node", "hardhat"],

    "rootDir": ".",
    "outDir": "./dist"
  },

  "include": [
    "./scripts",
    "./test",
    "./hardhat.config.ts",
    "./typechain-types"
  ]
}